{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fumi",
  "version": "0.1.0",
  "identifier": "dev.xelaods.fumi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fumi",
        "width": 1360,
        "height": 860,
        "minWidth": 920,
        "minHeight": 560,
        "decorations": false,
        "center": true,
        "backgroundColor": "#111113"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self' about: data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Gmail と iCloud メールのためのメールクライアント",
    "windows": {
      "nsis": { "languages": ["Japanese", "English"], "displayLanguageSelector": false }
    }
  }
}
